{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "trips-route": {
        "ClusterId": "trip-cluster",
        "Match": {
          "Path": "/trips/{**catch-all}"
        }
      },
      "trip-items-route": {
        "ClusterId": "trip-items-cluster",
        "Match": {
          "Path": "/trip-items/{**catch-all}"
        }
      },
      "weather-route": {
        "ClusterId": "weather-cluster",
        "Match": {
          "Path": "/weather/{**catch-all}"
        }
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/ai/{**catch-all}"
        }
      },
      "user-swagger-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/user-service/swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/user-service" }
        ]
      },
      "trip-swagger-route": {
        "ClusterId": "trip-cluster",
        "Match": {
          "Path": "/trip-service/swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/trip-service" }
        ]
      },
      "trip-items-swagger-route": {
        "ClusterId": "trip-items-cluster",
        "Match": {
          "Path": "/trip-items-service/swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/trip-items-service" }
        ]
      },
      "weather-swagger-route": {
        "ClusterId": "weather-cluster",
        "Match": {
          "Path": "/weather-service/swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/weather-service" }
        ]
      },
      "ai-swagger-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/ai-service/swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/ai-service" }
        ]
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://user-service:8080" }
        }
      },
      "trip-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://trip-service:8080" }
        }
      },
      "trip-items-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://trip-items-service:8080" }
        }
      },
      "weather-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://weather-service:8080" }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://ai-service:8080" }
        }
      }
    }
  }
}

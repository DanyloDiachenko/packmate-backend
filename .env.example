# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=readyroam_master_db
POSTGRES_PORT=5432

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@readyroam.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5055

# Redis
REDIS_PORT=6379

# JWT
JWT_SECRET_KEY=YourSuperSecretKeyForReadyRoamApp2026SecureKey!
JWT_ISSUER=ReadyRoamUserService
JWT_AUDIENCE=ReadyRoamClients

# Google Gemini AI Service
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-3.6-flash
AI_MAX_RECOMMENDATIONS=5

# Gmail SMTP Email Service
GMAIL_SENDER_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
GMAIL_SENDER_NAME=ReadyRoam Travel
